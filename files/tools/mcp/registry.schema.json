{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "typed-tool-registry",
  "type": "object",
  "required": [
    "version",
    "tools"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "roles",
          "args",
          "exec_mode",
          "sealed",
          "cache_key",
          "class_tags",
          "output_cap",
          "redact",
          "controls",
          "policy_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "auditor",
                "builder",
                "orchestrator",
                "hacker",
                "compliance",
                "crouton",
                "release-engineer"
              ]
            }
          },
          "args": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object"
              },
              "required": {
                "type": "array"
              },
              "additionalProperties": {
                "const": false
              }
            }
          },
          "exec_mode": {
            "type": "string",
            "enum": [
              "pure",
              "sandbox",
              "k1"
            ]
          },
          "sealed": {
            "type": "boolean"
          },
          "cache_key": {
            "type": "object",
            "required": [
              "tree",
              "check_id",
              "check_impl_sha",
              "engine"
            ],
            "properties": {
              "tree": {
                "type": "boolean"
              },
              "check_id": {
                "type": "boolean"
              },
              "check_impl_sha": {
                "type": "boolean"
              },
              "engine": {
                "type": "boolean"
              }
            }
          },
          "class_tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]+$"
            }
          },
          "output_cap": {
            "type": "integer",
            "minimum": 1024
          },
          "redact": {
            "const": true
          },
          "controls": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "expect"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^CTRL-[a-z0-9._-]+-[0-9]+$"
                },
                "expect": {
                  "type": "string",
                  "pattern": "^REJECT_[A-Z]+$"
                }
              }
            }
          },
          "policy_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
