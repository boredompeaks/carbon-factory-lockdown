{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "negative-controls",
  "type": "object",
  "required": [
    "version",
    "controls"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reject_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 234,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "role",
          "args",
          "expect",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "f_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]+$"
            }
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          },
          "expect": {
            "type": "string",
            "enum": [
              "REJECT_ARG",
              "REJECT_ENUM",
              "REJECT_PATH",
              "REJECT_PATTERN",
              "REJECT_PRECONDITION",
              "REJECT_POLICY",
              "REJECT_REDACTION",
              "REJECT_ROLE",
              "ACCEPT",
              "ASK_ONLY",
              "NOT_GRANTED",
              "ROLE_MATRIX",
              "ROLE_ALLOWED",
              "EMPTY"
            ]
          },
          "requires_runtime": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
