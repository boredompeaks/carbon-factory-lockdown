{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "negative-controls",
  "type": "object",
  "required": [
    "version",
    "controls"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reject_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 167,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "role",
          "args",
          "expect",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "f_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]+$"
            }
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          },
          "expect": {
            "type": "string",
            "pattern": "^REJECT_[A-Z]+$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
