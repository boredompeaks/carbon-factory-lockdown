{
  "version": "6A-3",
  "owner": "owner",
  "description": "Typed MCP tool registry: every role capability is a typed tool; no shell. Permission files are a generated fallback layer.",
  "tools": [
    {
      "name": "git.state",
      "description": "Repo state: head/tree/branch/clean/merge-base/is-ancestor/ls-tree. Replaces every rev-parse.",
      "roles": [
        "auditor",
        "builder",
        "orchestrator",
        "hacker",
        "crouton",
        "release-engineer"
      ],
      "args": {
        "type": "object",
        "properties": {},
        "required": [
          "fields"
        ],
        "additionalProperties": false,
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "head",
              "tree",
              "branch",
              "clean",
              "merge-base",
              "is-ancestor",
              "ls-tree"
            ]
          },
          "maxItems": 7
        },
        "rev": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "maxLength": 40
        },
        "path": {
          "type": "string",
          "pattern": "^(?!-)[^:\\r\\n]{1,240}$",
          "maxLength": 240
        }
      },
      "exec_mode": "pure",
      "sealed": true,
      "cache_key": {
        "tree": true,
        "check_id": false,
        "check_impl_sha": true,
        "engine": false
      },
      "class_tags": [
        "SCOPE_VIOLATION"
      ],
      "output_cap": 65536,
      "redact": true,
      "controls": [
        {
          "id": "CTRL-git.state-1",
          "expect": "REJECT_ROLE"
        },
        {
          "id": "CTRL-git.state-2",
          "expect": "REJECT_ARG"
        },
        {
          "id": "CTRL-git.state-3",
          "expect": "REJECT_ARG"
        }
      ],
      "policy_refs": [
        "files/policies/checks.json"
      ]
    },
