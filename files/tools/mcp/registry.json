    {
      "name": "check.run",
      "description": "One dispatcher for all checks.json checks; ruff pinned config on added lines; gitleaks --redact pinned config+baseline over base..head; semgrep anchored excludes. Builder code runs only in the sandbox; auditor runs at the git object id.",
      "roles": [
        "auditor",
        "builder",
        "hacker",
        "compliance"
      ],
      "args": {
        "type": "object",
        "properties": {},
        "required": [
          "check_id",
          "tree",
          "engine"
        ],
        "additionalProperties": false,
        "check_id": {
          "type": "string",
          "enum": [
            "SCOPE",
            "SUITE",
            "TEST_SET",
            "TEST_INFRA",
            "BASE_FAIL_HEAD_PASS",
            "MUTATION",
            "CHANGELOG",
            "SECRETS",
            "CONVENTION",
            "SMELL",
            "GATE_CONTROLS",
            "POLICY_DIGEST",
            "ARCH",
            "ORACLE_PROVENANCE",
            "GUARD_DELTA",
            "AUTHZ_MATRIX",
            "SEMGREP",
            "THREAD_RACE",
            "SCHEMA_FUZZ",
            "BOOTTEST",
            "ZIZMOR",
            "DAST_BASELINE",
            "AGT_PARITY",
            "AGT_AUDIT"
          ]
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "maxLength": 40
        },
        "engine": {
          "type": "string",
          "enum": [
            "sqlite",
            "postgres",
            "none"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "maxLength": 40,
          "default": null
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "maxLength": 40,
          "default": null
        },
        "line": {
          "type": "string",
          "pattern": "^(?!-)[^\\r\\n]{1,500}$",
          "maxLength": 500
        },
        "removed_id": {
          "type": "string",
          "pattern": "^(?!-)[^\\r\\n]{1,200}$",
          "maxLength": 200
        },
        "covered_by": {
          "type": "string",
          "pattern": "^(?!-)[^\\r\\n]{1,200}$",
          "maxLength": 200
        }
      },
      "exec_mode": "sandbox",
      "sealed": true,
      "cache_key": {
        "tree": true,
        "check_id": true,
        "check_impl_sha": true,
        "engine": true
      },
      "class_tags": [
        "AGT_AUDIT_GAP",
        "AGT_PARITY_MISMATCH",
        "ARCH_VIOLATION",
        "AUTHZ_MATRIX_GAP",
        "BARE_EXCEPT",
        "BOOT_FAIL_OPEN",
        "CHANGELOG_GAP",
        "CI_HARDENING",
        "CODE_SMELL",
        "CONTROL_UNDERCOUNT",
        "CONVENTION_VIOLATION",
        "DAST_FINDING",
        "FLAKY_TEST",
        "GATEWAY_IN_ATOMIC",
        "GATE_CONTROL_FAILURE",
        "GUARD_REMOVED",
        "LOCK_ACROSS_NETWORK",
        "MISSING_IDEMPOTENCY",
        "MUTABLE_DEFAULT",
        "NONATOMIC_WATERMARK",
        "NON_FALSIFIABLE",
        "POLICY_DRIFT",
        "RACE_CONDITION",
        "SCHEMA_FUZZ_FAILURE",
        "SCOPE_VIOLATION",
        "SECRET_LEAK",
        "SUITE_FAILURE",
        "TAUTOLOGICAL_ASSERTION",
        "TEST_GAP",
        "TEST_INFRA_CHANGE",
        "TEST_REMOVAL_UNCOVERED",
        "UNSAFE_RMW",
        "WEAK_ORACLE"
      ],
      "output_cap": 262144,
      "redact": true,
      "controls": [
        {
          "id": "CTRL-check.run-1",
          "expect": "REJECT_ROLE"
        },
        {
          "id": "CTRL-check.run-2",
          "expect": "REJECT_ARG"
        },
        {
          "id": "CTRL-check.run-3",
          "expect": "REJECT_ARG"
        }
      ],
      "policy_refs": [
        "files/policies/checks.json",
        "files/policies/check-runners.json",
        "files/policies/ci-required.json"
      ],
      "check_runners": {
