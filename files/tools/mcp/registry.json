          "builder",
          "auditor"
        ],
        "SUITE": [
          "builder",
          "auditor",
          "ci"
        ],
        "TEST_SET": [
          "builder",
          "auditor"
        ],
        "TEST_INFRA": [
          "builder",
          "auditor"
        ],
        "BASE_FAIL_HEAD_PASS": [
          "builder",
          "auditor"
        ],
        "MUTATION": [
