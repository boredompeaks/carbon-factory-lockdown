{
  "version": 1,
  "ci_self_audit": [
    "SUITE",
    "CHANGELOG",
    "SECRETS",
    "CONVENTION",
    "POLICY_DIGEST",
    "AUTHZ_MATRIX",
    "BOOTTEST",
    "ZIZMOR",
    "ARCH"
  ],
  "scope_definitions": {
    "added_lines": "only lines added by the diff",
    "closure": "diff paths plus their harness-computed dependency closure",
    "full": "the full repository at the audited tree"
  },
  "scope_by_runner_note": "When scope_by_runner is present it overrides scope per runner; every value names a scope_definitions key. A builder entry is the reduced scope for that check.",
  "checks": {
    "SCOPE": {
      "runners": [
        "builder",
        "auditor"
      ],
      "required_in_ci": false,
      "scope": "full",
      "emits": [
        "SCOPE_VIOLATION"
      ],
      "shadow": false
    },
    "SUITE": {
      "runners": [
        "auditor",
        "ci"
      ],
      "required_in_ci": true,
      "scope": "full",
      "emits": [
        "SUITE_FAILURE"
      ],
      "shadow": false
    },
    "TEST_SET": {
      "runners": [
        "builder",
        "auditor"
      ],
      "required_in_ci": false,
      "scope": "full",
      "emits": [
        "TEST_REMOVAL_UNCOVERED",
        "TAUTOLOGICAL_ASSERTION"
      ],
      "shadow": false
    },
    "TEST_INFRA": {
      "runners": [
        "builder",
        "auditor"
      ],
      "required_in_ci": false,
      "scope": "closure",
      "emits": [
        "TEST_INFRA_CHANGE"
      ],
      "shadow": false
    },
    "BASE_FAIL_HEAD_PASS": {
      "runners": [
        "builder",
        "auditor"
      ],
      "required_in_ci": false,
      "scope": "full",
      "scope_by_runner": {
        "builder": "closure",
        "auditor": "closure"
      },
      "emits": [
        "NON_FALSIFIABLE"
      ],
      "shadow": false
    },
    "MUTATION": {
      "runners": [
        "builder",
        "auditor"
      ],
      "required_in_ci": false,
      "scope": "added_lines",
      "scope_by_runner": {
        "builder": "closure",
        "auditor": "closure"
      },
      "emits": [
        "TEST_GAP"
      ],
      "shadow": false
    },
    "CHANGELOG": {
      "runners": [
        "builder",
        "auditor",
        "ci"
      ],
      "required_in_ci": true,
      "scope": "closure",
      "emits": [
        "CHANGELOG_GAP"
      ],
      "shadow": false
    },
    "SECRETS": {
      "runners": [
        "builder",
        "auditor",
        "ci"
