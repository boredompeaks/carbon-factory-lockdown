{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.json",
  "title": "capability",
  "version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "parent_capability_id",
    "lineage_id",
    "base",
    "head",
    "tree",
    "scope",
    "tier",
    "hacker_variant",
    "budget",
    "acceptance_test_refs",
    "acceptance_author_family",
    "characterization_tests",
    "architecture_allow",
    "guard_delta",
    "allowed_test_removals",
    "task_kind",
    "task_branch",
    "output_schema_ref",
    "policy_digest",
    "sig_status",
    "record_hash"
  ],
  "properties": {
    "schema": {
      "const": "capability/1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9_-]{8,64}$"
    },
    "parent_capability_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cap_[A-Za-z0-9_-]{8,64}$"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "$ref": "#/$defs/git_sha"
    },
    "head": {
      "$ref": "#/$defs/git_sha"
    },
    "tree": {
      "$ref": "#/$defs/git_sha"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "none",
        "high",
        "max"
      ]
    },
    "hacker_variant": {
      "type": "string",
      "enum": [
        "none",
        "high",
        "max"
      ]
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "acceptance_test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_author_family": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_author_policy": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_author_note": {
      "type": "string",
      "minLength": 1
    },
    "characterization_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterization_test"
      }
    },
    "architecture_allow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/architecture_allow"
      }
    },
    "guard_delta": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard_delta"
      }
    },
    "guard_ref": {
      "$ref": "#/$defs/guard_ref"
    },
    "allowed_test_removals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allowed_test_removal"
      }
    },
    "task_kind": {
      "type": "string",
      "enum": [
        "FEATURE",
        "FIX",
        "SECURITY",
        "DOC",
        "INFRA",
        "DRAIN"
      ]
    },
    "task_branch": {
      "type": "string",
      "pattern": "^(task/[A-Za-z0-9._-]+|spec-comp|lane/[a-z])$"
    },
    "branch": {
      "type": "string",
      "pattern": "^(task/[A-Za-z0-9._-]+|spec-comp|lane/[a-z])$"
    },
    "base_branch": {
      "type": "string",
      "pattern": "^(spec-comp|feat/add-frontend|lane/[a-z])$"
    },
    "output_schema_ref": {
      "const": "policies/schemas/builder-result.json"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "drain_cluster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "drain_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        null
      ]
    },
    "sig_status": {
      "const": "unsigned_local"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_kind": {
            "const": "DRAIN"
          }
        },
        "required": [
          "task_kind"
        ]
      },
      "then": {
        "required": [
          "drain_cluster_id",
          "drain_stage"
        ],
        "properties": {
          "drain_cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "drain_stage": {
            "type": "string",
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          },
          "acceptance_test_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_kind": {
            "const": "DRAIN"
          },
          "drain_stage": {
            "enum": [
              "R3",
              "R4",
              "R5"
            ]
          }
        },
        "required": [
          "task_kind",
          "drain_stage"
        ]
      },
      "then": {
        "required": [
          "guard_ref"
        ],
        "properties": {
          "guard_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "sha256"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "guard_ref": {
      "description": "Permanent guard reference: acceptance node id plus the SHA-256 of the guard node. Null on non-DRAIN and on DRAIN stages before R3 (backward compat for pre-R3 instances); an object on DRAIN R3/R4/R5 (Q-GUARD). Null is allowed strictly for stage < R3; at >= R3 an object is required.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "node_id",
        "sha256"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "git_sha": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_s",
        "tool_calls",
        "tokens"
      ],
      "properties": {
        "wall_clock_s": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "characterization_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "reason"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "architecture_allow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "edge",
            "dependency",
            "public_surface",
            "unowned_module"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guard_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "covered_by"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "covered_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_test_removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "reason_code",
        "covered_by"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "DUPLICATE_COVERAGE",
            "OBSOLETE_BEHAVIOUR",
            "RENAMED_TEST",
            "MERGED_TEST",
            "FIXTURE_ONLY",
            "FLAKY_QUARANTINE",
            "POLICY_PROHIBITED",
            "SECURITY_REGRESSION"
          ]
        },
        "covered_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason_code": {
                "enum": [
                  "DUPLICATE_COVERAGE",
                  "OBSOLETE_BEHAVIOUR",
                  "RENAMED_TEST",
                  "MERGED_TEST",
                  "FIXTURE_ONLY",
                  "FLAKY_QUARANTINE",
                  "POLICY_PROHIBITED",
                  "SECURITY_REGRESSION"
                ]
              }
            },
            "required": [
              "reason_code"
            ]
          },
          "then": {
            "properties": {
              "covered_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
