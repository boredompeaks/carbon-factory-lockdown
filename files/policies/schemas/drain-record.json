{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drain-record.json",
  "title": "drain-record",
  "version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "task_id",
    "lineage_id",
    "stage",
    "cluster_id",
    "class",
    "tree_sha",
    "state",
    "attempt_log_ref",
    "attempts",
    "defect_ids",
    "repro_ref",
    "row_count",
    "capability_id",
    "verdict_ref",
    "next_stage",
    "created_at",
    "prev_hash",
    "record_hash",
    "deleted",
    "policy_digest",
    "sig_status"
  ],
  "properties": {
    "schema": {
      "const": "drain-record/1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "REPRODUCED",
        "UNREPRODUCIBLE",
        "CLUSTERED",
        "REPAIRED",
        "VERIFIED",
        "CLOSED"
      ]
    },
    "attempt_log_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "defect_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repro_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "row_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cap_[A-Za-z0-9_-]{8,64}$",
      "description": "Null before R4 (or until capability is issued); when a string, must match capability.json capability_id (cap_ prefix). Pattern is ignored for null."
    },
    "verdict_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "guard_ref": {
      "$ref": "#/$defs/guard_ref"
    },
    "next_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        null
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "64-hex SHA-256 of the previous drain record (zero hash for R1 genesis: 64 zeros). Free-text hashes are rejected."
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deleted": {
      "const": false
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sig_status": {
      "const": "unsigned_local"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "UNREPRODUCIBLE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "attempt_log_ref",
          "attempts",
          "tree_sha"
        ],
        "properties": {
          "attempt_log_ref": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "type": "integer",
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R4"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "capability_id",
          "guard_ref"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^cap_[A-Za-z0-9_-]{8,64}$"
          },
          "guard_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "sha256"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R5"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "capability_id",
          "guard_ref",
          "verdict_ref"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^cap_[A-Za-z0-9_-]{8,64}$"
          },
          "guard_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "sha256"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "verdict_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "REPRODUCED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "repro_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "VERIFIED",
              "CLOSED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "verdict_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R1"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "OPEN",
              "UNREPRODUCIBLE"
            ]
          },
          "next_stage": {
            "const": "R2"
          }
        },
        "description": "Stage/state order: R1 (CONFIRM) is OPEN or UNREPRODUCIBLE, next R2. Late states (REPAIRED/VERIFIED/CLOSED) at R1 are invalid."
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R2"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "REPRODUCED",
              "UNREPRODUCIBLE",
              "CLUSTERED"
            ]
          },
          "next_stage": {
            "const": "R3"
          }
        },
        "description": "Stage/state order: R2 (EXPLOIT_SPEC) is REPRODUCED/UNREPRODUCIBLE/CLUSTERED, next R3. Early OPEN and late REPAIRED/VERIFIED/CLOSED at R2 are invalid."
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R3"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "REPRODUCED",
              "CLUSTERED",
              "UNREPRODUCIBLE"
            ]
          },
          "next_stage": {
            "const": "R4"
          }
        },
        "description": "Stage/state order: R3 (ACCEPTANCE_RED) is REPRODUCED/CLUSTERED/UNREPRODUCIBLE, next R4. OPEN and late REPAIRED/VERIFIED/CLOSED at R3 are invalid."
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R4"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "CLUSTERED",
              "REPAIRED",
              "VERIFIED"
            ]
          },
          "next_stage": {
            "const": "R5"
          }
        },
        "description": "Stage/state order: R4 (BUILD_AUDIT_RELEASE) is CLUSTERED/REPAIRED/VERIFIED, next R5. OPEN/REPRODUCED/UNREPRODUCIBLE/CLOSED at R4 are invalid."
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "R5"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "REPAIRED",
              "VERIFIED",
              "CLOSED"
            ]
          },
          "next_stage": {
            "type": "null"
          }
        },
        "description": "Stage/state order: R5 (PERMANENT_GUARD) is REPAIRED/VERIFIED/CLOSED, next_stage null (terminal). Early states at R5 are invalid."
      }
    }
  ],
  "$defs": {
    "guard_ref": {
      "description": "Permanent guard reference: acceptance node id plus the SHA-256 of the guard node. Null before R4; an object at R4/R5 (Q-GUARD, then post-merge permanence).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "node_id",
        "sha256"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
