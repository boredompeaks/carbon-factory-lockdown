{
  "version": 1,
  "evaluation": {
    "mode": "all_matching_rules",
    "order": "rule_id",
    "before_target": "builder",
    "max_prebuild_dispatches": 2,
    "halt_on_compliance_fail": true
  },
  "rules": [
    {
      "rule_id": "DR-DRAIN-01",
      "match": {
        "task_kind": [
          "DRAIN"
        ],
        "scope_globs": [
          "backend/**/views/**",
          "backend/**/api/**",
          "backend/**/serializers/**",
          "backend/**/orders/**",
          "backend/**/cart/**",
          "backend/**/shipping/**",
          "backend/**/migrations/**",
          "backend/**/common/**",
          "backend/common/**",
          "backend/**/accounts/**",
          "backend/**/account/**",
          "backend/**/roles/**",
          "backend/**/permissions/**",
          "backend/**/settings/**",
          "backend/**/settings.py",
          "backend/settings.py",
          "backend/settings/**",
          "backend/urls.py",
          "backend/**/urls.py",
          "backend/accounts/**",
          "backend/roles/**",
          "backend/accounts/views.py",
          "backend/accounts/models.py",
          "backend/common/roles.py",
          "backend/common/fields.py",
          "backend/common/testing.py",
          "backend/config/settings.py",
          "backend/orders/models.py",
          "frontend/**/checkout/**",
          "frontend/**/auth/**",
          "quality/ledger/**",
          "**/*.sql",
          "AGENTS.md"
        ],
        "keywords": [
          "role",
          "permission",
          "account",
          "checkout",
          "settings",
          "policy",
          "gate",
          "workflow",
          "migration",
          "common",
          "github"
        ]
      },
      "require_records": [
        {
          "stage": "R1",
          "schema": "drain-record/1",
          "min_count": 1
        },
        {
          "stage": "R2",
          "schema": "drain-record/1",
          "min_count": 1
        },
        {
          "stage": "R3",
          "schema": "drain-record/1",
          "min_count": 1
        }
      ],
      "require_before": "builder",
      "dispatch_first": [
        "compliance"
      ],
      "on_missing": {
        "action": "HALT",
        "reason_code": "DRAIN_STAGE_MISSING"
      },
      "on_compliance_result": {
        "PASS": {
          "action": "CONTINUE"
        },
        "FAIL": {
          "action": "HALT",
          "reason_code": "CTRL_FAILED"
        }
      }
    },
    {
      "rule_id": "DR-POLICY-01",
      "match": {
        "task_kind": [],
        "scope_globs": [
          "policies/**",
          "tools/**",
          ".opencode/**",
          ".github/workflows/**"
        ],
        "keywords": []
      },
      "dispatch_first": [
        "compliance"
      ],
      "require_before": "builder",
      "on_compliance_result": {
        "PASS": {
          "action": "CONTINUE"
        },
        "FAIL": {
          "action": "HALT",
          "reason_code": "CTRL_FAILED"
        }
      }
    },
    {
      "rule_id": "DR-SECURITY-01",
